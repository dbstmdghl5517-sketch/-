function 공구_트리거설치() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === '공구_새응답처리') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('공구_새응답처리')
    .forSpreadsheet(공구_응답시트[0]).onFormSubmit().create();
  Logger.log('공동구매 폼 제출 트리거 설치 완료 (응답 시트)');
}

/** 응답 시트에 폼이 제출되면 불린다. 처리한 행은 건너뛴다. */
function 공구_새응답처리(e) { 공구_새접수확인(); }

function 공구_확인() {
  var sh = 공구_응답탭();
  Logger.log('응답 탭     : ' + (sh ? sh.getName() + ' (' + (sh.getLastRow() - 1) + '건)' : '❗못 찾음 — 폼을 통합시트에 연결했는지 확인'));
  Logger.log('노션 토큰   : ' + (PropertiesService.getScriptProperties().getProperty('노션토큰') ? '있음' : '❗없음'));
  Logger.log('노션 상위   : https://www.notion.so/' + 공구_노션페이지);
  var 트리거 = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === '공구_새응답처리'; });
  Logger.log('제출 트리거 : ' + (트리거 ? '있음' : '없음 (10분 주기로만 처리됨 — 공구_트리거설치 실행)'));
}

/** 한 업체를 다시 만든다. 같은 제목의 옛 노션 공고·문서는 치운다. */
function 공구_다시만들기() {
  var 브랜드 = '';   // ← 브랜드명 (응답 1번 칸 그대로)
  if (브랜드 === '') { Logger.log('브랜드명을 적고 실행하세요.'); return; }
  var sh = 공구_응답탭();
  if (!sh) { Logger.log('응답 탭을 못 찾았습니다.'); return; }
  var 머리글 = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  for (var r = sh.getLastRow(); r >= 2; r--) {
    var 값들 = sh.getRange(r, 1, 1, sh.getLastColumn()).getDisplayValues()[0];
    if (칸읽기(값들, 머리글, 공구_항목.브랜드명) === 브랜드) {
      var 결과 = 공구_한건(공구_데이터(값들, 머리글, r));
      공구_알림([결과]);
      Logger.log(JSON.stringify(결과));
      return;
    }
  }
  Logger.log('그 브랜드의 응답이 없습니다: ' + 브랜드);
}

