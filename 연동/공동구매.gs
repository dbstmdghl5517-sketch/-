function 공구_응답탭() {
  function 맞나(sh) {
    if (sh.getLastColumn() < 1) return false;
    var h = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    return 공구_탭표지.every(function (k) { return 열찾기(h, k) >= 0; });
  }
  // 응답이 실제로 있는 탭을 먼저 고른다. 빈 옛 연결 탭에 걸리지 않게
  var 빈탭 = null;
  공구_응답시트.concat([통합시트_ID]).some(function (id) {
    var 목록;
    try { 목록 = SpreadsheetApp.openById(id).getSheets(); } catch (e) { return false; }
    for (var i = 0; i < 목록.length; i++) {
      if (!맞나(목록[i])) continue;
      if (목록[i].getLastRow() >= 2) { 빈탭 = { 찾음: 목록[i] }; return true; }
      if (!빈탭) 빈탭 = { 빈: 목록[i] };
    }
    return false;
  });
  return 빈탭 ? (빈탭.찾음 || 빈탭.빈) : null;
}

/** 새 접수를 찾아 가이드·노션 공고를 만든다. 폼 제출 트리거와 10분 주기에서 불린다. */
function 공구_새접수확인() {
  var sh = 공구_응답탭();
  if (!sh) { Logger.log('공동구매 응답 탭 없음 (폼 미연결)'); return { 성공: true, 신규: 0 }; }

  // 제출 트리거와 10분 주기가 동시에 돌면 같은 행을 두 번 만든다
  var 잠금 = LockService.getScriptLock();
  if (!잠금.tryLock(30000)) { Logger.log('다른 실행이 처리 중'); return { 성공: true, 신규: 0 }; }

  var 결과 = [];
  try {
    var 끝 = sh.getLastRow();
    if (끝 < 2) return { 성공: true, 신규: 0 };
    var 머리글 = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    var 값 = sh.getRange(2, 1, 끝 - 1, sh.getLastColumn()).getDisplayValues();   // 보이는 그대로. 「20%」 를 0.2 로 읽지 않게

    for (var i = 0; i < 값.length; i++) {
      var r = i + 2;
      var 브랜드 = 칸읽기(값[i], 머리글, 공구_항목.브랜드명);
      if (브랜드 === '') continue;
      var 키 = 처리키(공구폼, r, 브랜드);
      if (이미처리(키)) continue;
      처리기록(키);   // 먼저 적는다. 중간에 실패해도 매 10분 같은 메일이 쌓이지 않게
      결과.push(공구_한건(공구_데이터(값[i], 머리글, r)));
    }
  } finally {
    잠금.releaseLock();
  }

  if (!결과.length) { Logger.log('공동구매 신규 접수 없음'); return { 성공: true, 신규: 0 }; }
  try { 문의탭반영(); } catch (e) { Logger.log('문의탭반영 실패: ' + e); }
  공구_알림(결과);
  return { 성공: true, 신규: 결과.length, 결과: 결과 };
}

