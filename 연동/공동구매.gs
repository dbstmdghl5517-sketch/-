    줄.push('   가이드 : ' + (x.문서 || '❗실패'));
    for (var c in x.공고) 줄.push('   ' + c + ' 공고 : ' + (x.공고[c] || '❗실패'));
    if (x.빈칸.length) 줄.push('   ❗업체가 비운 칸 : ' + x.빈칸.map(function (k) { return 이름표[k] || k; }).join(', '));
    if (x.제안.length) 줄.push('   공통 문구로 채운 칸 : ' + x.제안.map(function (k) { return 이름표[k] || k; }).join(', '));
    x.오류.forEach(function (e) { 줄.push('   ❗' + e); });
    줄.push('');
  });
  줄.push('조사·보완 없이 업체가 쓴 그대로 나갔습니다. 손볼 곳이 있으면 노션에서 직접 고치거나,');
  줄.push('클로드에게 「6-1 <업체명> 보완」 이라고 지시하세요.');

  try { MailApp.sendEmail({ to: 주소, subject: 제목, body: 줄.join('\n') }); }
  catch (e) { Logger.log('메일 실패: ' + e); }
}
