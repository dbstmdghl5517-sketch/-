/** 응답 한 행 → { 브랜드, 접수일, 원: {...}, 항목: {이름: {구분, 원문, 보완}} } */
function 공구_데이터(값들, 머리글, 행) {
  var 원 = {};
  for (var k in 공구_항목) {
    if (k === '타임스탬프') continue;
    원[k] = 칸읽기(값들, 머리글, 공구_항목[k]);
  }
  var 접수 = 칸원본(값들, 머리글, 공구_항목.타임스탬프);
  var d = {
    행: 행,
    브랜드: 공구_브랜드표기(원.브랜드명),   // 공고·제목·이력용. 원문 전체는 원.브랜드명 (가이드에 싣는다)
    접수일: 날짜문자(접수),
    날짜: Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyy-MM-dd'),
    원: 원,
    항목: {}
  };

  // 업체가 쓴 값은 원문(검정), 비면 공통 문구를 제안(빨강)으로.
  // 「추후 전달」 「~인가요?」 처럼 값이 아닌 답은 원문을 가이드에 남기고 공고에는 안 내보낸다.
  function 넣(이름, 값, 기본) {
    if (비었나(값))            d.항목[이름] = { 구분: 기본 != null ? '제안' : '원문', 원문: '', 보완: 기본 || '' };
    else if (공구_미정(값))    d.항목[이름] = { 구분: '보완', 원문: 값, 보완: 기본 || '' };
    else                       d.항목[이름] = { 구분: '원문', 원문: 값, 보완: '' };
  }
  ['상품명', '상품링크', '정상가', '공구가', '수수료방식', '수수료', '산정기준',
   '혜택', '수량재고', '정산조건', '기타'].forEach(function (k) { 넣(k, 원[k], null); });
  넣('인원',     원.인원,     공구_기본.인원);
  넣('기간',     원.기간,     공구_기본.기간);
  넣('조건',     원.조건,     null);
  넣('필수내용', 원.필수내용, 공구_기본.필수내용.join('\n'));
  넣('필수장면', 원.필수장면, 공구_기본.필수장면.join('\n'));
  // 폼에 문항이 없는 것 — 항상 포포몬비즈 문구
  d.항목.게시글필수항목 = { 구분: '제안', 원문: '', 보완: 공구_기본.게시글.join('\n') };
  d.항목.금지사항       = { 구분: '제안', 원문: '', 보완: 공구_기본.금지.join('\n') };
  d.항목.필수해시태그   = { 구분: '제안', 원문: '', 보완: 공구_해시태그(원) };
  d.항목.업로드         = { 구분: '제안', 원문: '', 보완: 공구_기본.업로드 };
  return d;
}

function 공구_해시태그(원) {
  var b = 공구_브랜드표기(원.브랜드명).replace(/\s+/g, '');
  return (b ? '#' + b + ' ' : '') + '#공동구매 #공구';
}

/**
 * 「주식회사 다음장면 (리미씽)」 → 「리미씽」. 공고에는 회사명이 아니라 브랜드가 나가야 한다.
 * 괄호가 있으면 괄호 안을 브랜드로 본다. 없으면 법인 표기만 뗀다.
 */
function 공구_브랜드표기(s) {
  var t = String(s || '').trim();
  var m = t.match(/^(.+?)\s*[(（]\s*([^()（）]+?)\s*[)）]\s*$/);
  if (m) t = m[2];
  return t.replace(/^(주식회사|\(주\)|㈜)\s*|\s*(주식회사|\(주\)|㈜)$/g, '').trim() || String(s || '').trim();
}

/** 값 대신 「추후 전달」 「정리해서 드릴게요」 「~가능한가요?」 로 답한 칸 */
function 공구_미정(v) {
  var s = 텍스트(v);
  if (/[?？]\s*$/.test(s)) return true;
  return s.length <= 40 && /(재전달|추후|나중에|정리\s*(하여|해서|후)|전달\s*드리|드리겠습니다|드릴게요|예정입니다|협의|미정)/.test(s);
}

/** 34000 → 34,000원 / 「29000 (배송비 별도)」 → 「29,000원 (배송비 별도)」. 글로 쓴 금액은 그대로 둔다. */
function 공구_금액(s) {
  return String(s || '').replace(/^\s*(\d{4,})(?!\d)(?:\s*원)?/, function (_, n) {
    return n.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '원';
  });
}

/** 정상가·공구가가 둘 다 숫자로 읽힐 때만 할인율. 못 읽으면 빈 문자열 — 지어내지 않는다. */
function 공구_할인율(정상, 공구) {
  var a = Number(String(정상).replace(/[^0-9]/g, ''));
  var b = Number(String(공구).replace(/[^0-9]/g, ''));
  if (!a || !b || b >= a) return '';
  return Math.round((1 - b / a) * 100) + '%';
}

function 공구_값(d, 이름) {
  var it = d.항목[이름] || {};
  return it.구분 === '원문' ? (it.원문 || '') : (it.보완 || '');
}

/** 여러 줄 값을 불릿 목록으로. 앞에 붙은 -·•·숫자. 는 떼어 낸다. */
function 공구_줄목록(s) {
  return String(s || '').split(/\n+/)
    .map(function (x) { return x.replace(/^\s*(?:[-•·*]|\d+[.)])\s*/, '').trim(); })
    .filter(function (x) { return x !== ''; });
}

// ═══════════════════════════════════════════════════════════
// 한 건 처리
// ═══════════════════════════════════════════════════════════

function 공구_한건(d) {
  var 결과 = { 브랜드: d.브랜드, 행: d.행, 문서: '', 공고: {}, 오류: [], 빈칸: [] };

  ['인원', '기간', '상품링크', '공구가', '수수료'].forEach(function (k) {
    if (비었나(d.원[k]) || 공구_미정(d.원[k])) 결과.빈칸.push(k);
  });
  결과.제안 = ['필수내용', '필수장면'].filter(function (k) { return d.항목[k].구분 !== '원문'; });

  try { 결과.문서 = 공구_문서(d); }
  catch (e) { 결과.오류.push('가이드 문서: ' + e); }

  공구_채널.forEach(function (ch) {
    var url = '';
    try { url = 공구_노션(d, ch); }
    catch (e) { 결과.오류.push(ch.이름 + ' 노션: ' + e); }
    결과.공고[ch.이름] = url;
    try {
      if (결과.문서) 이력기록_가이드(공구_종류, ch.키, d.브랜드, d.날짜, 결과.문서, '공통 문구 자동 기입 (조사 없음)');
      if (url)       이력기록_공고(공구_종류, ch.키, d.브랜드, url);
    } catch (e) { 결과.오류.push('이력 기록: ' + e); }
  });

  Logger.log('공동구매 ' + d.브랜드 + ' → ' + JSON.stringify(결과));
  return 결과;
}

// ═══════════════════════════════════════════════════════════
// 가이드 구글 문서 (기업 확인용)
// ═══════════════════════════════════════════════════════════

function 공구_문서(d) {
  var 폴더 = 폴더확보(공구_폴더명);
  var 꼬리 = d.브랜드 + 공구_문서접미;
  var it = 폴더.getFiles();
  while (it.hasNext()) {
    var f = it.next();
    var n = f.getName();
    if (n === 꼬리 || n.slice(-(꼬리.length + 1)) === ' ' + 꼬리) f.setTrashed(true);
  }

  var doc = DocumentApp.create(d.날짜 + ' ' + 꼬리);
  var body = doc.getBody();
  body.clear();

  body.appendParagraph(d.브랜드 + ' 공동구매 진행 가이드')
      .setHeading(DocumentApp.ParagraphHeading.TITLE);
  body.appendParagraph('인스타 · 릴스 공동구매 크리에이터 모집·제작 가이드')
      .setHeading(DocumentApp.ParagraphHeading.SUBTITLE);
  body.appendParagraph('요청서 접수 → 크리에이터 모집 → 제품 수령·사용 → 콘텐츠 제작 → 원고 확인 → 공동구매 진행 → 정산');
  var p = body.appendParagraph('');
  var t = p.editAsText();
  넣기(t, '이 문서는 ', 검정, true);
  넣기(t, '크리에이터 모집 공고에 들어간 내용을 담당자님께 확인받기 위한 가이드입니다.\n', 검정, false);
  넣기(t, '검정 글씨는 담당자님이 제출해 주신 내용입니다.\n', 검정, false);
  넣기(t, '빨간 글씨는 비어 있던 항목에 포포몬비즈가 공통 기준으로 기입한 내용입니다. 확인 후 수정 요청해 주세요.', 빨강, true);

  제목(body, '상품 · 가격');
  표(body, d, [
    ['브랜드 · 업체',  null, d.원.브랜드명],
    ['상품명',         '상품명'],
    ['판매 페이지',    '상품링크'],
    ['정상 판매가',    '정상가'],
    ['공동구매 판매가', '공구가']
  ]);

  제목(body, '판매 수수료');
  표(body, d, [
    ['지급 방식',  '수수료방식'],
    ['지급 수수료', '수수료'],
    ['산정 기준',  '산정기준'],
    ['배송비 · 정산 조건', '정산조건']
  ]);

  제목(body, '모집 · 일정');
  표(body, d, [
    ['희망 크리에이터 인원', '인원'],
    ['희망 크리에이터 조건', '조건'],
    ['크리에이터 제공 혜택', '혜택'],
    ['제공 수량 · 판매 재고', '수량재고'],
    ['공동구매 진행 기간',   '기간'],
    ['업로드 방식',          '업로드'],
    ['모집 채널',            null, '인스타그램 게시물 · 인스타그램 릴스 (공고 각각 게시)']
  ]);

  제목(body, '콘텐츠에 반드시 포함할 내용');
  항목문단(body, d, '필수내용');

  제목(body, '반드시 촬영해야 하는 장면');
  항목문단(body, d, '필수장면');

  제목(body, '게시글에 포함해 주세요');
  항목문단(body, d, '게시글필수항목');
  표(body, d, [['필수 해시태그', '필수해시태그']]);

  제목(body, '사용하면 안 되는 표현 · 촬영 방식');
  항목문단(body, d, '금지사항');

  공구_채널.forEach(function (ch) {
    제목(body, ch.이름 + ' 제작 기준');
    목록(body, ch.기준);
  });

  if (!비었나(d.원.기타)) {
    제목(body, '기타 요청 및 유의사항');
    항목문단(body, d, '기타');
  }

  doc.saveAndClose();
  var file = DriveApp.getFileById(doc.getId());
  폴더.addFile(file);
  DriveApp.getRootFolder().removeFile(file);
  return doc.getUrl();
}

// ═══════════════════════════════════════════════════════════
// 노션 공고 (크리에이터 모집용) — 표 없이 제목·문단·불릿만 (4번·6번과 같다)
// ═══════════════════════════════════════════════════════════

function 공구_공고글(d, ch) {
  var L = [];
  var v = {};   // 공고에 내보낼 값. 「추후 전달」 같은 답은 빈 값이 된다
  ['상품명', '상품링크', '정상가', '공구가', '수수료방식', '수수료', '산정기준', '혜택', '조건', '정산조건']
    .forEach(function (k) { v[k] = 공구_값(d, k); });
  v.정상가 = 공구_금액(v.정상가);
  v.공구가 = 공구_금액(v.공구가);
  function 불릿들(arr) { arr.forEach(function (s) { L.push('- ' + s); }); }

  L.push('# ' + d.브랜드);
  L.push('## ' + ch.모집명);
  L.push('---');

  L.push('## 📋 모집 안내');
  L.push('- 진행 방식: 공동구매 (배송형)');
  if (v.상품명) L.push('- 판매 상품: ' + v.상품명);
  if (v.공구가) {
    var 할인 = 공구_할인율(v.정상가, v.공구가);
    L.push('- 공동구매가: ' + v.공구가 + (v.정상가 ? ' (정상가 ' + v.정상가 + (할인 ? ', 약 ' + 할인 + ' 할인' : '') + ')' : ''));
  }
  if (v.수수료 || v.수수료방식) {
    L.push('- 판매 수수료: ' + (v.수수료 || v.수수료방식)
      + (v.산정기준 ? ' (산정 기준: ' + v.산정기준 + ')' : ''));
  }
  if (v.혜택) L.push('- 크리에이터 혜택: ' + v.혜택);
  L.push('- 진행 기간: ' + 공구_값(d, '기간'));
  L.push('- 콘텐츠: ' + ch.콘텐츠);
  L.push('- 업로드: ' + 공구_기본.업로드);
  L.push('---');

  L.push('## 🙋 이런 분을 모집합니다');
  불릿들(ch.조건);
  불릿들(공구_줄목록(v.조건));
  불릿들(['공동구매 진행 기간에 맞춰 업로드해 주실 수 있는 분', '업로드 전 원고 확인이 가능한 분']);
  L.push('---');

  L.push('## 🛍 ' + (v.상품명 || d.브랜드));
  if (v.상품링크) L.push('판매 페이지: ' + v.상품링크);
  L.push('상세 정보는 판매 페이지에서 확인해 주세요.');
  L.push('---');

  L.push('# 🎯 이번 콘텐츠 핵심');
  L.push('이번 콘텐츠에서는 아래 내용을 중심으로 소개해 주세요.');
  불릿들(공구_줄목록(공구_값(d, '필수내용')));
  L.push('---');

  L.push('# 📸 ' + ch.장면제목);
  L.push('아래 내용은 기본적으로 포함해 주세요.');
  불릿들(공구_줄목록(공구_값(d, '필수장면')));
  L.push('이외 장면은 자유롭게 구성해 주세요.');
  불릿들(ch.기준);
  L.push('---');

  L.push('# 📝 게시글에 꼭 포함해 주세요');
  L.push('아래 내용은 콘텐츠 안에 자연스럽게 포함해 주세요.');
  공구_기본.게시글.forEach(function (s, i) { L.push((i + 1) + '. ' + s); });
  L.push('업체에서 전달한 문구를 그대로 나열하기보다 직접 사용한 경험을 본인의 말투로 작성해 주세요.');
  L.push('---');

  if (v.정산조건) {
    L.push('# 💰 배송 · 정산 안내');
    불릿들(공구_줄목록(v.정산조건));
    L.push('---');
  }

  L.push('# ⚠️ 작성 시 주의사항');
  불릿들(공구_기본.금지);
  L.push('---');

  L.push('# ✅ 업로드 전 원고 확인');
  L.push('본 캠페인은 업로드 전 원고 확인이 진행됩니다.');
  L.push('콘텐츠 작성 완료 후 초안을 먼저 전달해 주세요.');
  L.push('아래 내용을 중심으로 확인합니다.');
  불릿들([ch.키 === '릴스' ? '영상 내용 및 자막' : '사진·영상 및 본문 내용',
         '공동구매 가격·기간·구매 링크', '광고/협찬 표기 여부', '필수 내용 반영 여부', '표현 관련 사항']);
  L.push('확인 후 필요한 부분이 있을 경우 수정 요청을 드릴 수 있습니다.');
  L.push('최종 확인 후 업로드를 진행해 주세요.');
  L.push('---');

  L.push('# 🏷 필수 해시태그');
  L.push(공구_값(d, '필수해시태그'));
  L.push('---');

  L.push('# ⚠️ 캠페인 유의사항');
  불릿들(공구_기본.유의);
  return L;
}

function 공구_노션(d, ch) {
  var 토큰 = PropertiesService.getScriptProperties().getProperty('노션토큰');
  if (!토큰) throw new Error('노션토큰이 없습니다');

  var 제목글 = ch.이모지 + ' ' + d.날짜 + ' ' + d.브랜드 + ' ' + ch.이름 + ' 공동구매';
  var 꼬리 = ' ' + d.브랜드 + ' ' + ch.이름 + ' 공동구매';
  공구_옛공고치우기(토큰, 꼬리);

  var 블록 = 공구_공고글(d, ch).map(공구_블록);
  var res = 공구_노션요청(토큰, 'post', 'https://api.notion.com/v1/pages', {
    parent: { page_id: 공구_노션페이지 },
    properties: { title: { title: [{ type: 'text', text: { content: 제목글 } }] } },
    children: 블록.slice(0, 100)
  });
  for (var i = 100; i < 블록.length; i += 100) {
    공구_노션요청(토큰, 'patch', 'https://api.notion.com/v1/blocks/' + res.id + '/children',
                  { children: 블록.slice(i, i + 100) });
  }
  return res.url || '';
}

/** 같은 업체·채널의 옛 공고(제목 끝이 같음)는 보관한다. 다시 만들 때 둘이 남지 않게. */
function 공구_옛공고치우기(토큰, 꼬리) {
  var 커서 = null;
  do {
    var url = 'https://api.notion.com/v1/blocks/' + 공구_노션페이지 + '/children?page_size=100'
            + (커서 ? '&start_cursor=' + 커서 : '');
    var j = 공구_노션요청(토큰, 'get', url, null);
    (j.results || []).forEach(function (b) {
      if (b.type !== 'child_page') return;
      var n = b.child_page.title || '';
      if (n.slice(-꼬리.length) === 꼬리) {
        공구_노션요청(토큰, 'patch', 'https://api.notion.com/v1/pages/' + b.id, { archived: true });
        Logger.log('  옛 공고 보관: ' + n);
      }
    });
    커서 = j.has_more ? j.next_cursor : null;
  } while (커서);
}

function 공구_노션요청(토큰, 방식, url, 본문) {
  var opt = {
    method: 방식,
    headers: { Authorization: 'Bearer ' + 토큰, 'Notion-Version': '2022-06-28' },
    muteHttpExceptions: true
  };
  if (본문) { opt.contentType = 'application/json'; opt.payload = JSON.stringify(본문); }
  var r = UrlFetchApp.fetch(url, opt);
  if (r.getResponseCode() !== 200) {
    // 403 restricted_resource = 노션 무료 블록 한도 (2026-10-08 실제 발생)
    throw new Error('노션 ' + r.getResponseCode() + ' ' + r.getContentText().slice(0, 200));
  }
  return JSON.parse(r.getContentText());
}

/** 공고 한 줄 → 노션 블록. 노션올리기.sh 와 같은 표기를 쓴다. */
function 공구_블록(줄) {
  if (줄 === '---') return { object: 'block', type: 'divider', divider: {} };
  var 형 = 'paragraph', 글 = 줄, m;
  if ((m = 줄.match(/^(#{1,3}) (.*)$/))) { 형 = 'heading_' + m[1].length; 글 = m[2]; }
  else if ((m = 줄.match(/^- (.*)$/)))   { 형 = 'bulleted_list_item'; 글 = m[1]; }
  else if ((m = 줄.match(/^\d+\. (.*)$/))) { 형 = 'numbered_list_item'; 글 = m[1]; }
  var o = { object: 'block', type: 형 };
  o[형] = { rich_text: 공구_글조각(글) };
  return o;
}

/** 글 안의 URL 은 눌리게 링크로 만든다. 한 조각 2000자 제한. */
function 공구_글조각(s) {
  var 조각 = [], re = /https?:\/\/[^\s)]+/g, 앞 = 0, m;
  function 넣(t, 링크) {
    for (var i = 0; i < t.length; i += 2000) {
      var o = { type: 'text', text: { content: t.slice(i, i + 2000) } };
      if (링크) o.text.link = { url: 링크 };
      조각.push(o);
    }
  }
  while ((m = re.exec(s))) {
    if (m.index > 앞) 넣(s.slice(앞, m.index));
    넣(m[0], m[0]);
    앞 = m.index + m[0].length;
  }
  if (앞 < s.length) 넣(s.slice(앞));
  return 조각.length ? 조각 : [{ type: 'text', text: { content: ' ' } }];
}

