  if (!주소) { Logger.log('알림주소가 없어 메일을 못 보냅니다.'); return; }

  var 이름표 = { 인원: '희망 인원', 기간: '진행 기간', 상품링크: '판매 페이지', 공구가: '공동구매가', 수수료: '수수료',
                 필수내용: '필수 내용', 필수장면: '필수 장면' };
  var 제목 = '[포포몬비즈] 공동구매 접수 → 가이드·공고 자동 발행 ' + 결과.length + '건 — '
           + 결과.map(function (x) { return x.브랜드; }).join(', ');
  var 줄 = ['공동구매 캠페인 요청서가 접수되어 가이드와 노션 공고를 자동으로 만들었습니다.', ''];

  결과.forEach(function (x, i) {
